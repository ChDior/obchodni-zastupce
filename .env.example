# --- server ---
PORT=3000
DATABASE_URL=                 # postgres://uzivatel:heslo@host:5432/db – PostgreSQL server (má přednost před DATA_DIR/PGlite); migrace se aplikují při startu
DATA_DIR=.data/pg            # PGlite (PostgreSQL WASM) datový adresář; prázdné = in-memory
NODE_ENV=development
# --- admin bootstrap (vytvoří se jen pokud admin neexistuje) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-12
# --- AI (vyberte jednoho poskytovatele) ---
LLM_PROVIDER=                 # anthropic | openai | none ; prázdné = Anthropic, pokud je ANTHROPIC_API_KEY, jinak OpenAI
ANTHROPIC_API_KEY=            # https://console.anthropic.com -> API keys
ANTHROPIC_MODEL=claude-opus-5-5   # levnější: claude-sonnet-5-5, nejlevnější: claude-haiku-4-5 (effort/fallbacks se u něj ignorují)
ANTHROPIC_EFFORT=             # low|medium|high|xhigh|max (prázdné = výchozí modelu)
ANTHROPIC_FALLBACKS=true      # server-side fallback při odmítnutí klasifikátory (jen Claude API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1   # lokální Ollama: http://localhost:11434/v1 (+ OPENAI_API_KEY=ollama)
OPENAI_TIMEOUT_MS=            # u pomalých lokálních modelů zvyšte (např. 300000)
LLM_PRICE_INPUT_USD_PER_MTOK=         # volitelné: ceny modelu (USD / 1 mil. tokenů) pro odhad nákladů v administraci; prázdné = jen počty tokenů
LLM_PRICE_OUTPUT_USD_PER_MTOK=
LLM_PRICE_CACHE_READ_USD_PER_MTOK=
LLM_PRICE_CACHE_WRITE_USD_PER_MTOK=
# --- integrace ---
INTERNAL_TOKEN=change-me-long-random   # n8n -> /api/internal/*
SMTP_HOST=                             # přímé odesílání e-mailů (má přednost před n8n); prázdné = n8n/log
SMTP_PORT=587
SMTP_SECURE=                           # true = TLS od začátku (výchozí jen pro port 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BELETA Plus <obchod@example.cz>
N8N_EMAIL_WEBHOOK=                     # prázdné = e-maily se jen zapíšou do outboxu (transport "log")
WIDGET_FRAME_ANCESTORS=                # weby, které smějí vložit /widget do iframe (např. https://www.beleta.cz https://beleta.cz); prázdné = nikdo
PUBLIC_ORIGIN=http://localhost:3000
