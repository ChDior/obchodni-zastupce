# --- server ---
PORT=3000
DATA_DIR=.data/pg            # PGlite (PostgreSQL WASM) datový adresář; prázdné = in-memory
NODE_ENV=development
# --- admin bootstrap (vytvoří se jen pokud admin neexistuje) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-12
# --- AI (vyberte jednoho poskytovatele) ---
LLM_PROVIDER=                 # anthropic | openai | none ; prázdné = Anthropic, pokud je ANTHROPIC_API_KEY, jinak OpenAI
ANTHROPIC_API_KEY=            # https://console.anthropic.com -> API keys
ANTHROPIC_MODEL=claude-opus-5-5   # levnější varianta: claude-sonnet-5-5
ANTHROPIC_EFFORT=             # low|medium|high|xhigh|max (prázdné = výchozí modelu)
ANTHROPIC_FALLBACKS=true      # server-side fallback při odmítnutí klasifikátory (jen Claude API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1   # lokální Ollama: http://localhost:11434/v1 (+ OPENAI_API_KEY=ollama)
OPENAI_TIMEOUT_MS=            # u pomalých lokálních modelů zvyšte (např. 300000)
# --- integrace ---
INTERNAL_TOKEN=change-me-long-random   # n8n -> /api/internal/*
N8N_EMAIL_WEBHOOK=                     # prázdné = e-maily se jen zapíšou do outboxu (transport "log")
PUBLIC_ORIGIN=http://localhost:3000
